void drawQrCode(int x, int y) {
  QRCode qrcode;
  uint8_t qrData[qrcode_getBufferSize(4)];
  qrcode_initText(&qrcode, qrData, 4, ECC_LOW, "中秋節月餅");

  constexpr int scale = 2;
  constexpr int quietZone = 2;
  for (uint8_t row = 0; row < qrcode.size; ++row) {
    for (uint8_t column = 0; column < qrcode.size; ++column) {
      if (!qrcode_getModule(&qrcode, column, row)) continue;
      for (int dx = 0; dx < scale; ++dx) {
        for (int dy = 0; dy < scale; ++dy) {
          setWhitePixel(x + (column + quietZone) * scale + dx,
                        y + (row + quietZone) * scale + dy);
        }
      }
    }
  }
}

void drawMidAutumnLabel() {
  memset(blackImage, 0xFF, sizeof(blackImage));
  // White paper background; red is drawn only where the mythic artwork exists.
  memset(redImage, 0xFF, sizeof(redImage));
  drawMoonArt(106, 0);
  drawMidAutumnMessage(68, 100);
}

void setup() {
  Serial.begin(115200);
  delay(100);
  Serial.println("36_epaper: Mid-Autumn mooncake label");

  if (epd.Init() != 0) {
    Serial.println("e-Paper init failed");
    return;
  }

  drawMidAutumnLabel();
  epd.Display(blackImage, redImage);
  Serial.println("Display complete");
  delay(1000);
  epd.Sleep();
}

void loop() {}
