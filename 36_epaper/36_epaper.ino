void mapLandscapeToBuffer(int x, int y, int& bufferX, int& bufferY) {
  bufferX = y;
  bufferY = EPD_HEIGHT - 1 - x;
}

void setWhitePixel(int x, int y) {
  if (x < 0 || x >= EPD_HEIGHT || y < 0 || y >= EPD_WIDTH) return;
  int bufferX, bufferY;
  mapLandscapeToBuffer(x, y, bufferX, bufferY);
  const size_t index = static_cast<size_t>(bufferY) * (EPD_WIDTH / 8) + bufferX / 8;
  redImage[index] |= static_cast<uint8_t>(0x80 >> (bufferX % 8));
}

void setRedPixel(int x, int y) {
  if (x < 0 || x >= EPD_HEIGHT || y < 0 || y >= EPD_WIDTH) return;
  int bufferX, bufferY;
  mapLandscapeToBuffer(x, y, bufferX, bufferY);
  const size_t index = static_cast<size_t>(bufferY) * (EPD_WIDTH / 8) + bufferX / 8;
  redImage[index] &= static_cast<uint8_t>(~(0x80 >> (bufferX % 8)));
}

void setBlackPixel(int x, int y) {
  if (x < 0 || x >= EPD_HEIGHT || y < 0 || y >= EPD_WIDTH) return;
  int bufferX, bufferY;
  mapLandscapeToBuffer(x, y, bufferX, bufferY);
  const size_t index = static_cast<size_t>(bufferY) * (EPD_WIDTH / 8) + bufferX / 8;
  blackImage[index] &= static_cast<uint8_t>(~(0x80 >> (bufferX % 8)));
}

void drawMoonArt(int x, int y) {
  for (int row = 0; row < 100; ++row) {
    for (int column = 0; column < 84; ++column) {
      setWhitePixel(x + column, y + row);
      if (MOON_ART[row][column / 8] & (0x80 >> (column % 8))) {
        setRedPixel(x + column, y + row);
      }
    }
  }
}

void drawMidAutumnMessage(int x, int y) {
  for (int row = 0; row < 28; ++row) {
    for (int column = 0; column < 160; ++column) {
      if (MID_AUTUMN_MESSAGE[row][column / 8] & (0x80 >> (column % 8))) {
        setBlackPixel(x + column, y + row);
      }
    }
  }
}

